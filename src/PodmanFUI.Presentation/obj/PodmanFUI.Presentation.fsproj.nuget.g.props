    <PkgSpectre_Console Condition=" '$(PkgSpectre_Console)' == '' ">/home/lmo1720/.nuget/packages/spectre.console/0.57.2</PkgSpectre_Console>
    <PkgFSharp_Core Condition=" '$(PkgFSharp_Core)' == '' ">/home/lmo1720/.nuget/packages/fsharp.core/10.0.112</PkgFSharp_Core>
  </PropertyGroup>
</Project>